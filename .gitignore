# Node.js
**/node_modules/

# React build
**/build/

# Environment variables - ensure all .env files are ignored
.env
**/.env
*/**/.env
**/**/.env
**/**/**/.env
!.env.example
!**/.env.example
!*/**/.env.example
!**/**/.env.example

# Terraform
**/*.tfplan
**/terraform.tfstate
**/terraform.tfstate.*
**/.terraform/
**/data.fabric_capacity.capacity

# terraform.tfvars names resources in YOUR tenant - keep it local, ship the example.
**/terraform.tfvars
!**/terraform.tfvars.example

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Commit it so provider
# versions are reproducible for everyone who runs `terraform init`.

# Python
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/dist/
**/build/
**/venv/
**/env/
**/.venv/
**/.env.venv
**/pip-log.txt
**/pip-delete-this-directory.txt
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/*.egg
**/wheels/
**/.Python
**/site-packages/

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# IDE files
**/.vscode/
**/.idea/
**/.DS_Store
.claude/

# Demo presenter notes (private)
.demo/

# Miscellaneous
**/*.swp
**/*.swo
**/*.tmp
