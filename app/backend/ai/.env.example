# SQL Server connection string for the Python AI/RAG service
# Uses ADO.NET-style format with UID/PWD (not User Id/Password)

# Local SQL Server
MSSQL_CONNECTION_STRING=Server=<your-server>;Database=<your-database>;UID=<your-username>;PWD=<your-password>;TrustServerCertificate=yes;

# Azure SQL Database (alternative)
# MSSQL_CONNECTION_STRING=Server=<your-server>.database.windows.net;Database=<your-database>;UID=<your-username>;PWD=<your-password>;Encrypt=yes;

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1

# Performance tuning
# LLM_NUM_PREDICT: Max tokens to generate (lower = faster responses)
#   150 = ~2-3 sentences, good for demos (~3-5s)
#   100 = shorter responses (~2-3s)
#   256 = longer, more detailed responses (~6-10s)
LLM_NUM_PREDICT=150
# OLLAMA_NUM_THREAD: CPU threads for inference (0 = auto-detect all cores)
OLLAMA_NUM_THREAD=0

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
