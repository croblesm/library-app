# DB_CONNECTION_STRING for Microsoft Fabric SQL Database
DB_CONNECTION_STRING=Data Source=<your-fabric-server>,1433;Initial Catalog=<your-db>;Multiple Active Result Sets=False;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;Authentication=Active Directory Default;

# Local SQL Server variables (optional fallback)
DB_SERVER=<your-database-server>
DB_USER=<your-database-username>
DB_PASSWORD=<your-database-password>
DB_DATABASE=<your-database-name>